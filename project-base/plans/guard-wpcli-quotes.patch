diff --git a/.claude/hooks/guard-wpcli.mjs b/.claude/hooks/guard-wpcli.mjs
index 9148444..8074ffd 100644
--- a/.claude/hooks/guard-wpcli.mjs
+++ b/.claude/hooks/guard-wpcli.mjs
@@ -196,7 +196,9 @@ await safe( () => {
 		decide( 'allow', 'Чтение на сервере (логи, каталоги, версия PHP).' );
 	}

-	if ( /[;&|`]|\$\(/.test( remote ) ) {
+	// ; & | внутри кавычек — текст аргумента (PHP в wp eval, разметка блока); `…` и $(…) в двойных кавычках оболочка выполняет.
+	const bare = remote.replace( /"[^"]*"|'[^']*'/g, ( q ) => ( q[ 0 ] === '"' && /`|\$\(/.test( q ) ? q : '""' ) );
+	if ( /[;&|`]|\$\(/.test( bare ) ) {
 		// WP-CLI в составной команде (текст через $(… | base64 -d)) — подтверждение с автодампом; на stage тоже подтверждение.
 		ctx.wp = /^(\S*\/)?wp\s/.test( remote );
 		ctx.strict = true;
