# Whitelist: всё запрещено, разрешено только необходимое.
# Репозиторий приватный: ACCESS.md, всё `.vscode/` и `project-base/` коммитим.
# SSH-ключ (~/.ssh/…) в git не кладём.
# Слаги темы/плагинов/mu-плагинов — из project-base/project.json:
#   node .claude/skills/project-ops/scripts/gen-whitelist.mjs

/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.stylelintrc.json
!/phpcs.xml.dist
!/CLAUDE.md
!/LICENSE
!/.mcp.json
!/.claude/
!/.claude/**
!/.vscode/
!/.vscode/**
!/ACCESS.md
!/project-base/
!/project-base/**
# >>> project.json (генерируется, не править вручную)
!/wp-content/
/wp-content/*
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/plugins/
/wp-content/plugins/*
!/wp-content/mu-plugins/
/wp-content/mu-plugins/*
# <<< project.json

# Локальное состояние агента
/.claude/.state/
/.claude/settings.local.json

# Мусор внутри разрешённых деревьев
**/.DS_Store
**/Thumbs.db
**/desktop.ini
**/*.log
**/*.tmp
**/*.temp
**/*.bak
**/node_modules/
**/vendor/

# Дампы БД — только на сервере (персональные данные, GDPR)
/project-base/dumps/

# Тяжёлые исходники и медиа — в облачной папке, ссылка в ACCESS.md
/project-base/**/*.psd
/project-base/**/*.ai
/project-base/**/*.fig
/project-base/**/*.sketch
/project-base/**/*.xd
/project-base/**/*.mp4
/project-base/**/*.mov
/project-base/**/*.zip
/project-base/**/*.raw

# Секреты — нигде
**/*.pem
**/*.key
**/.env
**/.env.*
**/.ssh/
