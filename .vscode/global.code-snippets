{
	"Small Comment": {
		"scope": "php,scss,javascript,css,json",
		"prefix": "//",
		"body": "// ========== $0 ========== //",
		"description": "Короткий комментарий-разделитель"
	},
	"Big Comment": {
		"scope": "php,scss,javascript,css",
		"prefix": "///",
		"body": [
			"// =========================================================================== //",
			"// $0",
			"// =========================================================================== //"
		],
		"description": "Большой блок комментария"
	},
	"Small Comment End": {
		"scope": "php,scss,javascript,css",
		"prefix": "//e",
		"body": "// ========== END - $0 ========== //",
		"description": "Закрывающий короткий комментарий"
	},
	"Big Comment End": {
		"scope": "php,scss,javascript,css",
		"prefix": "///e",
		"body": [
			"// =========================================================================== //",
			"// END - $0",
			"// =========================================================================== //"
		],
		"description": "Закрывающий большой блок"
	}
}